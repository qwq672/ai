<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_model_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_compat_badge"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/compat_badge_ok"
            android:src="@android:drawable/presence_online"
            android:tint="@color/status_ok"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/tv_model_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_incompat_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_incompat_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/incompat_badge"
            android:textColor="@color/status_err"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_model_spec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_model_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pick"
            style="@style/Widget.GenieX.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/use_this"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_download_model"
            style="@style/Widget.GenieX.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/btn_download"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_detail"
            style="@style/Widget.GenieX.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/detail"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_delete_model"
            style="@style/Widget.GenieX.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/delete"
            android:textColor="@color/status_err"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
